# Copy this file to .env and adjust values as needed.
# Defaults below are fine for local development; change credentials
# before ever running this anywhere other than your own machine.

# --- Docker / Airflow file permissions -------------------------------
# On Linux, set this to your host UID (`id -u`) so files Airflow writes
# into bind-mounted folders (e.g. orchestration/dags) are owned by you,
# not root. 50000 is the default baked into the Airflow image and is
# fine on macOS/Windows Docker Desktop.
AIRFLOW_UID=50000

# --- Postgres: analytical warehouse -----------------------------------
POSTGRES_WAREHOUSE_HOST=postgres-warehouse
POSTGRES_WAREHOUSE_PORT=5432
POSTGRES_WAREHOUSE_DB=eeg_warehouse
POSTGRES_WAREHOUSE_USER=warehouse_user
POSTGRES_WAREHOUSE_PASSWORD=warehouse_pass_change_me

# --- Postgres: Airflow's own metadata database ------------------------
# Kept separate from the warehouse above -- this is an implementation
# detail of the orchestrator, not part of the platform's data model.
POSTGRES_AIRFLOW_HOST=postgres-airflow
POSTGRES_AIRFLOW_PORT=5432
POSTGRES_AIRFLOW_DB=airflow
POSTGRES_AIRFLOW_USER=airflow_user
POSTGRES_AIRFLOW_PASSWORD=airflow_pass_change_me

# --- Airflow ------------------------------------------------------------
# Fernet key used by Airflow to encrypt connection passwords at rest.
# Generate your own with:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW__CORE__FERNET_KEY=

AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin_change_me
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- MinIO: raw/landing object storage ---------------------------------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_pass_change_me
# Hostname reachable from *inside* the Docker network (other containers).
# Scripts run on the host machine instead should use http://localhost:9000.
MINIO_ENDPOINT=http://minio:9000
MINIO_RAW_BUCKET=eeg-raw
